entrypoint = "roundaboutsim.py"
modules = ["python-3.8:v2-20230907-3d66d15"]

hidden = [".pythonlibs"]

[nix]
channel = "stable-23_05"
packages = ["SDL2", "SDL2_image", "SDL2_mixer", "SDL2_ttf", "cairo", "ffmpeg-full", "fontconfig", "freetype", "ghostscript", "glibcLocales", "gobject-introspection", "gtk3", "libjpeg", "libpng", "pkg-config", "portmidi", "qhull", "tcl", "tk"]

[env]
LANG = "en_US.UTF-8"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Roundabout Simulation"

[[workflows.workflow]]
name = "Roundabout Simulation"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py"

[workflows.workflow.metadata]
outputType = "console"
